  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcao         Role
  dreId          String?
  dre            DRE?       @relation(fields: [dreId], references: [id], onDelete: Cascade)
  escolaId       String?
  escola         Escola?    @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  municipioId    String?
  municipio      Municipio? @relation(fields: [municipioId], references: [id])
  produtorId     String?
  produtor       Produtor?  @relation(fields: [produtorId], references: [id])
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  ativo          Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([userId])
  @@index([dreId])
  @@index([escolaId])
  @@index([produtorId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("vinculos_usuario")
}

model RepresentacaoFornecedor {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtorId           String
  produtor             Produtor  @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  tipoRepresentacao    String    @default("REPRESENTANTE")
  permissoes           String    @default("CONSULTAR")
  autorizacaoDocumento String?
  vigenciaInicio       DateTime
  vigenciaFim          DateTime?
  ativo                Boolean   @default(true)
  revogadoEm           DateTime?
  revogadoPor          String?
  motivoRevogacao      String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([userId])
  @@index([produtorId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("representacoes_fornecedor")
}

model AditivoItem {
  id                    String          @id @default(uuid())
  aditivoId             String
  contratoItemId        String
  quantidadeAnterior    Decimal         @db.Decimal(14, 4)
  quantidadeNova        Decimal         @db.Decimal(14, 4)
  valorUnitarioAnterior Decimal         @db.Decimal(14, 4)
  valorUnitarioNovo     Decimal         @db.Decimal(14, 4)
  valorTotalAnterior    Decimal         @db.Decimal(14, 2)
  valorTotalNovo        Decimal         @db.Decimal(14, 2)
  aditivo               AditivoContrato @relation(fields: [aditivoId], references: [id])
  contratoItem          ContratoItem    @relation(fields: [contratoItemId], references: [id], map: "pnae_contrato_aditivo_itens_item_fkey")

  @@index([aditivoId])
  @@index([contratoItemId])
  @@map("pnae_contrato_aditivo_itens")
}

model AditivoContrato {
  id               String                @id @default(uuid())
  contratoId       String
  numeroSequencial Int
  tipo             TipoAditivoContrato
  tipoOutro        String?
  justificativa    String                @db.Text
  data             DateTime?
  vigenciaInicio   DateTime?
  vigenciaFim      DateTime?
  valorAlteracao   Decimal               @default(0.00) @db.Decimal(14, 2)
  status           StatusAditivoContrato @default(RASCUNHO)
  formalizadoEm    DateTime?
  responsavelId    String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  itens            AditivoItem[]
  contrato         Contrato              @relation(fields: [contratoId], references: [id])
  documentos       ContratoDocumento[]
  signatarios      ContratoSignatario[]

  @@unique([contratoId, numeroSequencial])
  @@index([contratoId])
  @@index([status])
  @@map("pnae_contrato_aditivos")
}

model ContratoDocumento {
  id                String                    @id @default(uuid())
  contratoId        String
  aditivoId         String?
  tipo              TipoDocumentoContrato
  versao            Int
  titulo            String
  arquivoPath       String?
  arquivoNome       String?
  mimeType          String?
  tamanhoBytes      Int?
  hashSha256        String?                   @db.VarChar(64)
  formalizado       Boolean                   @default(false)
  assinaturaDigital Boolean                   @default(false)
  origemAssinatura  OrigemAssinaturaContrato?
  geradoEm          DateTime?
  geradoPor         String?
  observacao        String?                   @db.Text
  createdAt         DateTime                  @default(now())
  createdBy         String?
  aditivo           AditivoContrato?          @relation(fields: [aditivoId], references: [id], onDelete: Restrict)
  contrato          Contrato                  @relation(fields: [contratoId], references: [id])

  @@index([aditivoId])
  @@index([contratoId])
  @@map("pnae_contrato_documentos")
}

model ContratoItem {
  id                        String                     @id @default(uuid())
  contratoId                String
  editalItemId              String?
  propostaItemId            String
  produto                   String
  descricao                 String?                    @db.Text
  unidade                   String?
  quantidadeContratada      Decimal                    @db.Decimal(14, 4)
  valorUnitario             Decimal                    @db.Decimal(14, 4)
  valorTotal                Decimal                    @db.Decimal(14, 2)
  quantidadeAditivada       Decimal                    @default(0.0000) @db.Decimal(14, 4)
  quantidadeDisponivel      Decimal                    @db.Decimal(14, 4)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @default(now()) @updatedAt
  deletedAt                 DateTime?
  createdBy                 String?
  updatedBy                 String?
  aditivoItens              AditivoItem[]
  contrato                  Contrato                   @relation(fields: [contratoId], references: [id])
  editalItem                EditalItem?                @relation(fields: [editalItemId], references: [id], onDelete: Restrict)
  propostaItem              PropostaItem               @relation(fields: [propostaItemId], references: [id])
  programacaoItens          ProgramacaoEntregaItem[]
  notaFiscalItens           NotaFiscalItem[]
  vinculosRecebimentoFiscal VinculoRecebimentoFiscal[]

  @@index([contratoId])
  @@index([editalItemId])
  @@index([propostaItemId])
  @@map("pnae_contrato_itens")
}

model ContratoSignatario {
  id                    String           @id @default(uuid())
  contratoId            String
  aditivoId             String?
  nome                  String
  cargo                 String?
  papel                 String
  enviadoEm             DateTime?
  documentoRegistradoEm DateTime?
  documentoId           String?
  createdAt             DateTime         @default(now())
  createdBy             String?
  aditivo               AditivoContrato? @relation(fields: [aditivoId], references: [id], onDelete: Restrict)
  contrato              Contrato         @relation(fields: [contratoId], references: [id])

  @@index([aditivoId])
  @@index([contratoId])
  @@map("pnae_contrato_signatarios")
}

model Contrato {
  id                           String                     @id @default(uuid())
  numero                       String
  exercicio                    Int
  editalId                     String
  chamadaPublica               String?
  propostaId                   String
  produtorId                   String
  escolaId                     String?
  dreId                        String?
  municipioId                  String?
  valorInicial                 Decimal                    @db.Decimal(14, 2)
  valorAtualizado              Decimal                    @db.Decimal(14, 2)
  dataAssinatura               DateTime?
  vigenciaInicio               DateTime?
  vigenciaFim                  DateTime?
  status                       StatusContrato             @default(RASCUNHO)
  objeto                       String?                    @db.Text
  observacoes                  String?                    @db.Text
  condicoesFornecimento        String?                    @db.Text
  condicoesPagamento           String?                    @db.Text
  fiscalizacao                 String?                    @db.Text
  instrumentoExternoRegistrado Boolean                    @default(false)
  instrumentoRegistradoEm      DateTime?
  versao                       Int                        @default(1)
  createdAt                    DateTime                   @default(now())
  updatedAt                    DateTime                   @default(now()) @updatedAt
  deletedAt                    DateTime?
  createdBy                    String?
  updatedBy                    String?
  aditivos                     AditivoContrato[]
  documentos                   ContratoDocumento[]
  itens                        ContratoItem[]
  signatarios                  ContratoSignatario[]
  dre                          DRE?                       @relation(fields: [dreId], references: [id], onDelete: Restrict)
  edital                       Edital                     @relation(fields: [editalId], references: [id])
  escola                       Escola?                    @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  municipio                    Municipio?                 @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  produtor                     Produtor                   @relation(fields: [produtorId], references: [id])
  proposta                     Proposta                   @relation(fields: [propostaId], references: [id])
  programacoes                 ProgramacaoEntrega[]
  notasFiscais                 NotaFiscal[]
  vinculosRecebimentoFiscal    VinculoRecebimentoFiscal[]
  atestos                      Atesto[]
  liquidacoes                  Liquidacao[]
  pagamentos                   Pagamento[]

  @@unique([numero, exercicio])
  @@index([dreId])
  @@index([editalId])
  @@index([escolaId])
  @@index([municipioId])
  @@index([produtorId])
  @@index([propostaId])
  @@index([status])
  @@index([vigenciaFim])
  @@map("pnae_contratos")
}

model EntregaDocumento {
