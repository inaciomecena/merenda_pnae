  dre            DRE       @relation(fields: [dreId], references: [id], onDelete: Cascade)
  vigenciaInicio DateTime
  vigenciaFim    DateTime?
  ativo          Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  @@index([escolaId])
  @@index([dreId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("vinculo_escola_dre")
}

model VinculoUsuario {
