  updatedBy           String?
  edital              Edital                    @relation(fields: [editalId], references: [id], onDelete: Restrict)
  entidadeExecutora   EntidadeExecutora?        @relation(fields: [entidadeExecutoraId], references: [id], onDelete: Restrict)
  dre                 DRE?                      @relation(fields: [dreId], references: [id], onDelete: Restrict)
  municipio           Municipio?                @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  escolas             ChamadaPublicaEscola[]
  documentos          ChamadaPublicaDocumento[]
  inscricoes          InscricaoChamada[]
  projetos            Proposta[]
  requisitos          RequisitoHabilitacao[]
  resultados          ResultadoChamada[]
  recursos            RecursoChamada[]
  homologacao         HomologacaoChamada?

  @@unique([numero, exercicio])
  @@index([editalId])
  @@index([dreId, municipioId])
  @@index([status, inscricoesFim])
  @@map("pnae_chamadas_publicas")
}

model ChamadaPublicaEscola {
  id        String         @id @default(uuid())
  chamadaId String
  escolaId  String
  chamada   ChamadaPublica @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  escola    Escola         @relation(fields: [escolaId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())

  @@unique([chamadaId, escolaId])
  @@index([escolaId])
  @@map("pnae_chamadas_publicas_escolas")
}

model ChamadaPublicaDocumento {
  id          String         @id @default(uuid())
  chamadaId   String
  versao      Int            @default(1)
  tipo        String
  titulo      String
  arquivoPath String?
  arquivoNome String?
  mimeType    String?
  hashSha256  String?        @db.VarChar(64)
  publicado   Boolean        @default(false)
  createdAt   DateTime       @default(now())
  createdBy   String?
  chamada     ChamadaPublica @relation(fields: [chamadaId], references: [id], onDelete: Cascade)

  @@index([chamadaId, versao])
  @@map("pnae_chamadas_publicas_documentos")
}

model InscricaoChamada {
  id            String                 @id @default(uuid())
  chamadaId     String
  produtorId    String
  categoria     CategoriaParticipante
  representante String?
  contato       String?
  status        StatusInscricaoChamada @default(ATIVA)
  inscritoEm    DateTime               @default(now())
  observacoes   String?                @db.Text
  chamada       ChamadaPublica         @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  produtor      Produtor               @relation(fields: [produtorId], references: [id], onDelete: Restrict)

  @@unique([chamadaId, produtorId])
  @@index([produtorId])
  @@map("pnae_inscricoes_chamadas")
}

model RequisitoHabilitacao {
  id           String                 @id @default(uuid())
  chamadaId    String
  categoria    CategoriaParticipante?
  tipo         String
  descricao    String
  obrigatorio  Boolean                @default(true)
  validadeDias Int?
  chamada      ChamadaPublica         @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  documentos   HabilitacaoDocumento[]

  @@index([chamadaId, categoria])
  @@map("pnae_requisitos_habilitacao")
}

model HabilitacaoDocumento {
  id           String                   @id @default(uuid())
  propostaId   String
  requisitoId  String?
  versao       Int                      @default(1)
  tipo         String
  titulo       String
  arquivoPath  String?
  arquivoNome  String?
  mimeType     String?
  tamanhoBytes Int?
  hashSha256   String?                  @db.VarChar(64)
  validadeAte  DateTime?
  status       StatusHabilitacaoChamada @default(PENDENTE)
  parecer      String?                  @db.Text
  conferidoEm  DateTime?
  conferidoPor String?
  createdAt    DateTime                 @default(now())
  createdBy    String?
  proposta     Proposta                 @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  requisito    RequisitoHabilitacao?    @relation(fields: [requisitoId], references: [id], onDelete: Restrict)

  @@index([propostaId, tipo, versao])
  @@index([requisitoId])
  @@map("pnae_habilitacao_documentos")
}

model AnaliseHabilitacao {
  id           String                   @id @default(uuid())
  propostaId   String                   @unique
  status       StatusHabilitacaoChamada @default(PENDENTE)
  parecer      String?                  @db.Text
  pendencias   String?                  @db.Text
  analisadoEm  DateTime?
  analisadoPor String?
  versao       Int                      @default(1)
  proposta     Proposta                 @relation(fields: [propostaId], references: [id], onDelete: Cascade)

  @@map("pnae_analises_habilitacao")
}

model ClassificacaoProjeto {
  id                    String               @id @default(uuid())
  propostaId            String
  editalItemId          String
  prioridade            Int
  criterio              String
  valorConsiderado      Decimal?             @db.Decimal(14, 4)
  justificativa         String?              @db.Text
  quantidadeSelecionada Decimal              @default(0) @db.Decimal(14, 4)
  valorSelecionado      Decimal              @default(0) @db.Decimal(14, 2)
  status                StatusSelecaoChamada @default(PENDENTE)
  criadoPor             String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  proposta              Proposta             @relation(fields: [propostaId], references: [id], onDelete: Cascade)
  editalItem            EditalItem           @relation(fields: [editalItemId], references: [id], onDelete: Restrict)

  @@unique([propostaId, editalItemId])
  @@index([editalItemId, prioridade])
  @@map("pnae_classificacoes_projetos")
}

model ResultadoChamada {
  id            String         @id @default(uuid())
  chamadaId     String
  versao        Int            @default(1)
  tipo          String
  geradoEm      DateTime       @default(now())
  geradoPor     String?
  justificativa String?        @db.Text
  dadosJson     String         @db.LongText
  chamada       ChamadaPublica @relation(fields: [chamadaId], references: [id], onDelete: Cascade)

  @@unique([chamadaId, versao])
  @@index([chamadaId, tipo])
  @@map("pnae_resultados_chamadas")
}

model RecursoChamada {
  id            String               @id @default(uuid())
  chamadaId     String
  propostaId    String?
  produtorId    String
  fundamentacao String               @db.Text
  anexosJson    String?              @db.LongText
  prazoFinal    DateTime?
  status        StatusRecursoChamada @default(PENDENTE)
  decisao       String?              @db.Text
  decididoEm    DateTime?
  decididoPor   String?
  createdAt     DateTime             @default(now())
  createdBy     String?
  chamada       ChamadaPublica       @relation(fields: [chamadaId], references: [id], onDelete: Cascade)
  proposta      Proposta?            @relation(fields: [propostaId], references: [id], onDelete: Restrict)
  produtor      Produtor             @relation(fields: [produtorId], references: [id], onDelete: Restrict)

  @@index([chamadaId, status])
  @@index([produtorId])
  @@map("pnae_recursos_chamadas")
}

model HomologacaoChamada {
  id            String         @id @default(uuid())
  chamadaId     String         @unique
  resultadoId   String?
  homologadoEm  DateTime       @default(now())
  homologadoPor String
  fundamentacao String         @db.Text
  documentoId   String?
  chamada       ChamadaPublica @relation(fields: [chamadaId], references: [id], onDelete: Cascade)

  @@map("pnae_homologacoes_chamadas")
}

model ConfiguracaoInstitucional {
  id                 String                               @id @default(uuid())
  chave              String
  valor              String                               @db.Text
  tipo               String                               @default("texto")
  escopo             EscopoInstitucional                  @default(GLOBAL)
  origem             OrigemConfiguracao                   @default(ADMINISTRATIVA)
  permiteSobrescrita Boolean                              @default(true)
  ativo              Boolean                              @default(true)
  versao             Int                                  @default(1)
  vigenteDesde       DateTime                             @default(now())
  vigenteAte         DateTime?
  responsavelId      String?
  dreId              String?
  escolaId           String?
  municipioId        String?
  createdAt          DateTime                             @default(now())
  updatedAt          DateTime                             @updatedAt
  responsavel        User?                                @relation("ConfigResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  dre                DRE?                                 @relation("ConfigDre", fields: [dreId], references: [id], onDelete: Restrict)
  escola             Escola?                              @relation("ConfigEscola", fields: [escolaId], references: [id], onDelete: Restrict)
  municipio          Municipio?                           @relation("ConfigMunicipio", fields: [municipioId], references: [id], onDelete: Restrict)
  historico          ConfiguracaoInstitucionalHistorico[]

  @@index([chave, escopo, ativo])
  @@index([dreId, escolaId, municipioId])
  @@map("pnae_configuracoes_institucionais")
}

model ConfiguracaoInstitucionalHistorico {
  id             String                    @id @default(uuid())
  configuracaoId String
  versao         Int
  valor          String                    @db.Text
  responsavelId  String?
  alteradoEm     DateTime                  @default(now())
  observacao     String?                   @db.Text
  configuracao   ConfiguracaoInstitucional @relation(fields: [configuracaoId], references: [id], onDelete: Cascade)
  responsavel    User?                     @relation("ConfigHistoryResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@unique([configuracaoId, versao])
  @@index([alteradoEm])
  @@map("pnae_configuracoes_institucionais_historico")
}

model ParametroOperacional {
  id               String                       @id @default(uuid())
  codigo           String                       @unique
  descricao        String                       @db.Text
  tipo             String                       @default("texto")
  escopo           EscopoInstitucional          @default(GLOBAL)
  unidade          String?
  origem           OrigemConfiguracao           @default(ADMINISTRATIVA)
  fonteNormativa   String?
  permiteAlteracao Boolean                      @default(true)
  status           StatusParametroOperacional   @default(PENDENTE_VALIDACAO)
  versaoAtual      Int                          @default(0)
  responsavelId    String?
  vigenteDesde     DateTime?
  vigenteAte       DateTime?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  responsavel      User?                        @relation("ParametroResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  versoes          ParametroOperacionalVersao[]

  @@index([status, escopo])
  @@map("pnae_parametros_operacionais")
}

model ParametroOperacionalVersao {
  id             String                     @id @default(uuid())
  parametroId    String
  versao         Int
  valor          String                     @db.Text
  escopo         EscopoInstitucional        @default(GLOBAL)
  dreId          String?
  escolaId       String?
  municipioId    String?
  status         StatusParametroOperacional @default(PENDENTE_VALIDACAO)
  justificativa  String?                    @db.Text
  fonteNormativa String?
  vigenteDesde   DateTime                   @default(now())
  vigenteAte     DateTime?
  responsavelId  String?
  createdAt      DateTime                   @default(now())
  parametro      ParametroOperacional       @relation(fields: [parametroId], references: [id], onDelete: Cascade)
  responsavel    User?                      @relation("ParametroVersaoResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@unique([parametroId, versao])
  @@index([escopo, dreId, escolaId, municipioId])
  @@map("pnae_parametros_operacionais_versoes")
}

model NotificacaoInterna {
  id             String                   @id @default(uuid())
  userId         String
  tipo           String
  titulo         String
  mensagem       String                   @db.Text
  status         StatusNotificacaoInterna @default(NAO_LIDA)
  referenciaTipo String?
  referenciaId   String?
  link           String?
  origem         String?
  dedupeKey      String                   @unique
  escopo         EscopoInstitucional      @default(GLOBAL)
  dreId          String?
  escolaId       String?
  municipioId    String?
  criadoEm       DateTime                 @default(now())
  lidaEm         DateTime?
  user           User                     @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, criadoEm])
  @@index([escopo, dreId, escolaId, municipioId])
  @@map("pnae_notificacoes_internas")
}

model ChecklistImplantacao {
  id            String                     @id @default(uuid())
  nome          String
  escopo        EscopoInstitucional        @default(GLOBAL)
  dreId         String?
  escolaId      String?
  municipioId   String?
  status        StatusChecklistImplantacao @default(NAO_INICIADO)
  observacao    String?                    @db.Text
  responsavelId String?
  criadoEm      DateTime                   @default(now())
  atualizadoEm  DateTime                   @updatedAt
  responsavel   User?                      @relation("ChecklistResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)
  dre           DRE?                       @relation("ChecklistDre", fields: [dreId], references: [id], onDelete: Restrict)
  escola        Escola?                    @relation("ChecklistEscola", fields: [escolaId], references: [id], onDelete: Restrict)
  municipio     Municipio?                 @relation("ChecklistMunicipio", fields: [municipioId], references: [id], onDelete: Restrict)
  itens         ItemChecklistImplantacao[]

  @@index([status, escopo])
  @@index([dreId, escolaId, municipioId])
  @@map("pnae_checklists_implantacao")
}

model ItemChecklistImplantacao {
  id            String                         @id @default(uuid())
  checklistId   String
  codigo        String
  titulo        String
  status        StatusItemChecklistImplantacao @default(PENDENTE)
  evidencia     String?                        @db.Text
  responsavelId String?
  prazo         DateTime?
  observacao    String?                        @db.Text
  pendencia     String?                        @db.Text
  atualizadoEm  DateTime                       @updatedAt
  checklist     ChecklistImplantacao           @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  responsavel   User?                          @relation("ChecklistItemResponsavel", fields: [responsavelId], references: [id], onDelete: SetNull)

  @@unique([checklistId, codigo])
  @@index([status, prazo])
  @@map("pnae_itens_checklist_implantacao")
}

