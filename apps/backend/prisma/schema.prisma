generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCOLA
  EXTENSIONISTA
  DRE
  PRODUTOR
  REPRESENTANTE
}

enum StatusEdital {
  RASCUNHO
  ATIVO
  FECHADO
  CANCELADO
}

enum StatusItemEdital {
  PENDENTE
  IMPORTADO
  CONFIRMADO
  PENDENTE_EDICAO
  PENDENTE_CONFERENCIA
}

enum StatusImportacao {
  AGUARDANDO_PROCESSAMENTO
  PROCESSANDO
  PROCESSADO
  PENDENTE_CONFERENCIA
  CONFIRMADO
  ERRO
}

enum StatusMatch {
  MATCH_AUTOMATICO
  SUGESTAO
  PENDENTE
  SEM_MATCH
  APROVADO
  REJEITADO
}

enum OrigemMatch {
  AUTOMATICO
  MANUAL
}

enum StatusProposta {
  RASCUNHO
  GERADA
  FINALIZADA
  CANCELADA
}

enum TipoProposta {
  ANEXO_III
  PROJETO_VENDA
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  escolaId     String?
  escola       Escola?   @relation(fields: [escolaId], references: [id])
  municipioId  String?
  municipio    Municipio? @relation(fields: [municipioId], references: [id])
  vinculos     VinculoUsuario[]
  representacoes RepresentacaoFornecedor[]

  @@map("users")
}

model Municipio {
  id            String    @id @default(uuid())
  nome          String
  nomeNormalizado String?
  uf            String
  codigoIbge    String?   @unique
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  escolas       Escola[]
  produtores    Produtor[]
  editais       Edital[]
  users         User[]
  entidadesExecutoras EntidadeExecutora[]
  vinculosUsuario VinculoUsuario[]

  @@index([uf, nomeNormalizado])
  @@map("municipios")
}

model Escola {
  id            String    @id @default(uuid())
  nome          String
  codigo        String?   @unique
  municipioId   String
  municipio     Municipio @relation(fields: [municipioId], references: [id])
  endereco      String?
  telefone      String?
  responsavel   String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  restricaoAtendimento String?
  localizacao String?
  localidadeDiferenciada String?
  categoriaAdministrativa String?
  dependenciaAdministrativa String?
  categoriaEscolaPrivada String?
  conveniadaPoderPublico String?
  regulamentacaoConselho String?
  porteEscola String?
  etapasModalidades String? @db.Text
  outrasOfertasEducacionais String?
  latitude Decimal? @db.Decimal(12, 8)
  longitude Decimal? @db.Decimal(12, 8)
  editais       Edital[]
  editaisVinculados EditalEscola[]
  matches       Match[]
  users         User[]
  vinculosDRE   VinculoEscolaDRE[]
  vinculosUsuario VinculoUsuario[]

  @@map("escolas")
}

model Edital {
  id            String          @id @default(uuid())
  numero        String
  ano           Int
  titulo        String
  descricao     String?         @db.Text
  objeto        String?         @db.Text
  status        StatusEdital    @default(RASCUNHO)
  municipioId   String?
  municipio     Municipio?      @relation(fields: [municipioId], references: [id])
  escolaId      String?
  escola        Escola?         @relation(fields: [escolaId], references: [id])
  arquivoFonte  String?
  observacoes   String?         @db.Text
  dataPublicacao DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  itens         EditalItem[]
  propostas     Proposta[]
  importLogs    ImportLog[]
  matches       Match[]
  escolasVinculadas EditalEscola[]
  documento       EditalDocumento?

  @@map("pnae_editais")
}

model EditalEscola {
  id        String   @id @default(uuid())
  editalId  String
  edital    Edital   @relation(fields: [editalId], references: [id])
  escolaId  String
  escola    Escola   @relation(fields: [escolaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([editalId, escolaId])
  @@map("pnae_edital_escolas")
}

model EditalItem {
  id                  String            @id @default(uuid())
  editalId            String
  edital              Edital            @relation(fields: [editalId], references: [id])
  numeroItem          Int?
  produtoOriginal     String
  especificacao      String?           @db.Text
  quantidade         Decimal?          @db.Decimal(10, 2)
  unidade            String?
  precoUnitario      Decimal?          @db.Decimal(10, 2)
  valorTotal         Decimal?          @db.Decimal(10, 2)
  observacoes        String?           @db.Text
  produtoReferenciaId String?
  produtoReferencia  ProdutoReferencia? @relation(fields: [produtoReferenciaId], references: [id])
  status             StatusItemEdital  @default(PENDENTE)
  pendenteEdicao     Boolean           @default(false)
  importadoAutomaticamente Boolean     @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  matches            Match[]

  @@map("pnae_edital_itens")
}

model ProdutoReferencia {
  id                    String         @id @default(uuid())
  nome                  String
  categoria             String?
  subcategoria          String?
  unidadePadrao         String?
  palavrasChave         String?
  sinonimos             String?
  agriculturaFamiliar   Boolean        @default(true)
  ativo                 Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  editalItems           EditalItem[]
  matches               Match[]

  @@map("pnae_produtos_referencia")
}

model Produtor {
  id              String            @id @default(uuid())
  nome            String
  cpfCnpj         String?           @unique
  municipioId     String
  municipio       Municipio         @relation(fields: [municipioId], references: [id])
  endereco        String?
  telefone        String?
  dadosDocumentais Json?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  produtos        ProdutorProduto[]
  matches         Match[]
  propostas       Proposta[]
  representacoes  RepresentacaoFornecedor[]
  vinculosUsuario VinculoUsuario[]

  @@map("produtores")
}

model ProdutorProduto {
  id               String    @id @default(uuid())
  produtorId       String
  produtor         Produtor  @relation(fields: [produtorId], references: [id])
  produto          String
  capacidade       String?
  periodoProducao  String?
  precoSugerido    Decimal?  @db.Decimal(10, 2)
  unidade          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  matches          Match[]

  @@map("produtor_produtos")
}

model Match {
  id                   String               @id @default(uuid())
  editalId             String?
  edital               Edital?              @relation(fields: [editalId], references: [id])
  editalItemId         String
  editalItem           EditalItem           @relation(fields: [editalItemId], references: [id])
  produtoReferenciaId  String?
  produtoReferencia    ProdutoReferencia?   @relation(fields: [produtoReferenciaId], references: [id])
  produtorId           String?
  produtor             Produtor?            @relation(fields: [produtorId], references: [id])
  produtorProdutoId    String?
  produtorProduto      ProdutorProduto?     @relation(fields: [produtorProdutoId], references: [id])
  escolaId             String?
  escola               Escola?              @relation(fields: [escolaId], references: [id])
  scoreMatch           Int                  @default(0) @map("score")
  status               StatusMatch          @default(PENDENTE)
  origemMatch          OrigemMatch          @default(AUTOMATICO)
  motivoScore          String?              @db.Text
  observacoes          String?              @map("observacao") @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?
  propostaItems        PropostaItem[]

  @@map("pnae_matches")
}

model Proposta {
  id               String           @id @default(uuid())
  editalId         String
  edital           Edital           @relation(fields: [editalId], references: [id])
  produtorId       String?
  produtor         Produtor?        @relation(fields: [produtorId], references: [id])
  numero           String?
  tipoDocumento    TipoProposta     @default(ANEXO_III)
  status           StatusProposta   @default(RASCUNHO)
  validadeDias     Int              @default(30)
  prazoEntrega     Int              @default(15)
  valorTotal       Decimal?         @db.Decimal(12, 2)
  arquivoPdfPath   String?
  arquivoDocxPath  String?
  observacao       String?
  documentosJson   String?          @db.LongText
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  itens            PropostaItem[]

  @@map("pnae_propostas")
}

model PropostaItem {
  id               String    @id @default(uuid())
  propostaId       String
  proposta         Proposta  @relation(fields: [propostaId], references: [id])
  matchId          String?
  match            Match?    @relation(fields: [matchId], references: [id])
  produto          String
  especificacao    String?
  marca            String?
  quantidade       Decimal?  @db.Decimal(10, 2)
  unidade          String?
  precoUnitario    Decimal?  @db.Decimal(10, 2)
  valorTotal       Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  @@map("pnae_proposta_itens")
}

model ImportLog {
  id              String    @id @default(uuid())
  editalId        String?
  edital          Edital?   @relation(fields: [editalId], references: [id])
  arquivoNome     String
  arquivoCaminho  String
  origem          String
  status          StatusImportacao @default(AGUARDANDO_PROCESSAMENTO)
  tituloExtraido  String?
  numeroExtraido  String?
  anoExtraido     Int?
  municipioNome   String?
  escolaNome      String?
  objeto          String?   @db.Text
  resumo          String?   @db.Text
  quantidadeItens Int       @default(0)
  tempoProcessamentoMs Int?
  mensagemErro    String?   @db.Text
  processadoEm    DateTime?
  confirmadoEm    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  estrutura       ImportacaoEstrutura?

  @@map("pnae_import_logs")
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  userName      String?
  userEmail     String?
  userRole      String?
  action        String
  entity        String
  entityId      String?
  entityLabel   String?
  oldValues     String?   @db.Text
  newValues     String?   @db.Text
  ipAddress     String?
  userAgent     String?
  endpoint      String?
  method        String?
  statusCode    Int?
  durationMs    Int?
  metadata      String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("pnae_audit_logs")
}

model SystemConfig {
  id            String    @id @default(uuid())
  chave         String    @unique
  valor         String    @db.Text
  descricao     String?
  tipo          String    @default("texto")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("pnae_system_config")
}

enum TipoDocumentoTemplate {
  EDITAL_PRINCIPAL
  ANEXO_I
  ANEXO_II
  ANEXO_III
  ANEXO_IV
  ANEXO_V
  ANEXO_VI
  ANEXO_VII
}

enum FormatoTemplate {
  HTML
  DOCX
  TEXTO
  PDF
}

enum StatusComposicaoEdital {
  RASCUNHO
  EM_CONFERENCIA
  PRONTO_PARA_GERAR
  GERADO
  PUBLICADO
  CANCELADO
}

enum StatusGeracaoDocumento {
  SUCESSO
  ERRO
  VALIDACAO
}

model TemplateDocumento {
  id              String                 @id @default(uuid())
  tipo            TipoDocumentoTemplate
  numeroAnexo     Int?
  titulo          String
  descricao       String?                @db.Text
  finalidade      String                 @default("EDITAL")
  perfilFornecedor String?
  codigoModelo     String?                @unique
  ordem           Int                    @default(0)
  ativo           Boolean                @default(true)
  formato         FormatoTemplate        @default(HTML)
  vigenciaInicio  DateTime?
  vigenciaFim     DateTime?
  arquivoBase     String?
  conteudo        String?                @db.LongText
  versaoAtual     Int                    @default(1)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  versoes         TemplateVersao[]
  campos          CampoTemplate[]
  anexosEdital    EditalAnexo[]

  @@index([tipo, ativo])
  @@map("pnae_templates_documento")
}

model TemplateVersao {
  id             String                 @id @default(uuid())
  templateId     String
  template       TemplateDocumento      @relation(fields: [templateId], references: [id])
  numero         Int
  titulo         String
  conteudo       String?                @db.LongText
  formato        FormatoTemplate
  arquivoBase    String?
  vigenciaInicio DateTime?
  vigenciaFim    DateTime?
  observacao     String?                @db.Text
  createdAt      DateTime               @default(now())
  createdBy      String?
  anexos         EditalAnexo[]

  @@unique([templateId, numero])
  @@map("pnae_template_versoes")
}

model CampoTemplate {
  id           String                  @id @default(uuid())
  templateId   String
  template     TemplateDocumento       @relation(fields: [templateId], references: [id])
  chave        String
  rotulo       String
  tipo         String                  @default("texto")
  obrigatorio  Boolean                 @default(false)
  valorPadrao  String?                 @db.Text
  repetitivo   Boolean                 @default(false)
  anexoTipo    TipoDocumentoTemplate?
  ordem        Int                     @default(0)
  createdAt    DateTime                @default(now())

  @@index([templateId, chave])
  @@map("pnae_campos_template")
}

model EditalDocumento {
  id                      String                  @id @default(uuid())
  editalId                String                  @unique
  edital                  Edital                  @relation(fields: [editalId], references: [id])
  statusComposicao        StatusComposicaoEdital  @default(RASCUNHO)
  processoAdministrativo  String?
  localRecebimento        String?                 @db.Text
  dataRecebimento         DateTime?
  horarioRecebimento      String?
  comissao                String?                 @db.Text
  legislacaoAplicavel     String?                 @db.Text
  prazoVigencia           String?
  condicoesParticipacao   String?                 @db.LongText
  criteriosHabilitacao    String?                 @db.LongText
  regrasEntrega           String?                 @db.Text
  formaPagamento          String?                 @db.Text
  penalidades             String?                 @db.Text
  foro                    String?
  observacoesDocumento    String?                 @db.Text
  origem                  String                  @default("MANUAL")
  arquivoFonte            String?
  importacaoId            String?
  conteudoManual          String?                 @db.LongText
  versaoAtual             Int                     @default(1)
  publicadoEm             DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  createdBy               String?
  updatedBy               String?
  versoes                 EditalVersao[]
  anexos                  EditalAnexo[]
  variaveis               EditalVariavel[]
  geracoes                HistoricoGeracaoDocumento[]

  @@index([statusComposicao])
  @@index([importacaoId])
  @@map("pnae_edital_documentos")
}

model EditalVersao {
  id               String                 @id @default(uuid())
  documentoId      String
  documento        EditalDocumento        @relation(fields: [documentoId], references: [id])
  numero           Int
  statusComposicao StatusComposicaoEdital
  snapshot         String                 @db.LongText
  motivo           String?                @db.Text
  createdAt        DateTime               @default(now())
  createdBy        String?
  geracoes         HistoricoGeracaoDocumento[]

  @@unique([documentoId, numero])
  @@map("pnae_edital_versoes")
}

model EditalAnexo {
  id               String                 @id @default(uuid())
  documentoId      String
  documento        EditalDocumento        @relation(fields: [documentoId], references: [id])
  templateId       String?
  template         TemplateDocumento?     @relation(fields: [templateId], references: [id])
  templateVersaoId String?
  templateVersao   TemplateVersao?        @relation(fields: [templateVersaoId], references: [id])
  tipo             TipoDocumentoTemplate
  ordem            Int                    @default(0)
  titulo           String
  incluido         Boolean                @default(true)
  conteudoManual   String?                @db.LongText
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([documentoId, ordem])
  @@map("pnae_edital_anexos")
}

model EditalVariavel {
  id            String                  @id @default(uuid())
  documentoId   String
  documento     EditalDocumento         @relation(fields: [documentoId], references: [id])
  chave         String
  valor         String?                 @db.LongText
  valorExtraido String?                 @db.LongText
  origem        String                  @default("manual")
  confianca     String?
  paginaOrigem  Int?
  obrigatorio   Boolean                 @default(false)
  sensivel      Boolean                 @default(false)
  escopo        String                  @default("")
  statusRevisao String                  @default("confirmado")
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([documentoId, chave, escopo])
  @@map("pnae_edital_variaveis")
}

model ImportacaoEstrutura {
  id              String            @id @default(uuid())
  importLogId     String            @unique
  importLog       ImportLog         @relation(fields: [importLogId], references: [id])
  editalId        String?
  textoExtraido   String?           @db.LongText
  secoesJson      String?           @db.LongText
  anexosJson      String?           @db.LongText
  tabelasJson     String?           @db.LongText
  assinaturasJson String?           @db.LongText
  confiancaGeral  String?
  parametrizado   String?           @db.LongText
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  campos          ImportacaoCampo[]

  @@map("pnae_importacao_estruturas")
}

model ImportacaoCampo {
  id             String              @id @default(uuid())
  estruturaId    String
  estrutura      ImportacaoEstrutura @relation(fields: [estruturaId], references: [id])
  chave          String
  rotulo         String
  valor          String?             @db.Text
  valorExtraido  String?             @db.Text
  trecho         String?             @db.Text
  origem         String              @default("extraido_automaticamente")
  confianca      String?
  paginaOrigem   Int?
  secao          String?
  editavel       Boolean             @default(true)
  sensivel       Boolean             @default(false)
  statusRevisao  String              @default("pendente_revisao")
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([estruturaId, chave])
  @@map("pnae_importacao_campos")
}

model HistoricoGeracaoDocumento {
  id            String                 @id @default(uuid())
  documentoId   String
  documento     EditalDocumento        @relation(fields: [documentoId], references: [id])
  editalId      String
  versaoId      String?
  versao        EditalVersao?          @relation(fields: [versaoId], references: [id])
  versaoNumero  Int
  usuarioId     String?
  usuarioNome   String?
  formato       String
  arquivoPath   String?
  status        StatusGeracaoDocumento
  mensagem      String?                @db.Text
  ipAddress     String?
  createdAt     DateTime               @default(now())

  @@index([editalId, createdAt])
  @@index([documentoId])
  @@map("pnae_historico_geracao_documento")
}

// SDD-002: Modelo Organizacional

model EntidadeExecutora {
  id            String    @id @default(uuid())
  nome          String
  cnpj          String?   @unique
  tipo          String    @default("PREFEITURA")
  uf            String
  municipioId   String?
  municipio     Municipio? @relation(fields: [municipioId], references: [id])
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  dres          DRE[]

  @@index([uf])
  @@index([municipioId])
  @@map("entidades_executoras")
}

model DRE {
  id                    String             @id @default(uuid())
  nome                  String
  codigo                String?            @unique
  entidadeExecutoraId   String
  entidadeExecutora     EntidadeExecutora  @relation(fields: [entidadeExecutoraId], references: [id], onDelete: Restrict)
  municipioSede         String?
  ativo                 Boolean            @default(true)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  vinculosEscolas       VinculoEscolaDRE[]
  vinculosUsuarios      VinculoUsuario[]

  @@index([entidadeExecutoraId])
  @@map("dres")
}

model VinculoEscolaDRE {
  id              String    @id @default(uuid())
  escolaId        String
  escola          Escola    @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  dreId           String
  dre             DRE       @relation(fields: [dreId], references: [id], onDelete: Cascade)
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([escolaId])
  @@index([dreId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("vinculo_escola_dre")
}

model VinculoUsuario {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  funcao          Role
  dreId           String?
  dre             DRE?      @relation(fields: [dreId], references: [id], onDelete: Cascade)
  escolaId        String?
  escola          Escola?   @relation(fields: [escolaId], references: [id], onDelete: Cascade)
  municipioId     String?
  municipio       Municipio? @relation(fields: [municipioId], references: [id])
  produtorId      String?
  produtor        Produtor?  @relation(fields: [produtorId], references: [id])
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?
  ativo           Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([userId])
  @@index([dreId])
  @@index([escolaId])
  @@index([produtorId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("vinculos_usuario")
}

model RepresentacaoFornecedor {
  id                   String    @id @default(uuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  produtorId           String
  produtor             Produtor  @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  tipoRepresentacao    String    @default("REPRESENTANTE")
  permissoes           String    @default("CONSULTAR")
  autorizacaoDocumento String?
  vigenciaInicio       DateTime
  vigenciaFim          DateTime?
  ativo                Boolean   @default(true)
  revogadoEm           DateTime?
  revogadoPor          String?
  motivoRevogacao      String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  createdBy            String?
  updatedBy            String?

  @@index([userId])
  @@index([produtorId])
  @@index([vigenciaInicio, vigenciaFim])
  @@map("representacoes_fornecedor")
}

