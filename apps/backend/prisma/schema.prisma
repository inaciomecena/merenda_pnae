generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCOLA
  EXTENSIONISTA
}

enum StatusEdital {
  RASCUNHO
  ATIVO
  FECHADO
  CANCELADO
}

enum StatusItemEdital {
  PENDENTE
  IMPORTADO
  CONFIRMADO
  PENDENTE_EDICAO
  PENDENTE_CONFERENCIA
}

enum StatusImportacao {
  AGUARDANDO_PROCESSAMENTO
  PROCESSANDO
  PROCESSADO
  PENDENTE_CONFERENCIA
  CONFIRMADO
  ERRO
}

enum StatusMatch {
  MATCH_AUTOMATICO
  SUGESTAO
  PENDENTE
  SEM_MATCH
  APROVADO
  REJEITADO
}

enum OrigemMatch {
  AUTOMATICO
  MANUAL
}

enum StatusProposta {
  RASCUNHO
  GERADA
  FINALIZADA
  CANCELADA
}

enum TipoProposta {
  ANEXO_III
  PROJETO_VENDA
}

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  role         Role      @default(ADMIN)
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  escolaId     String?
  escola       Escola?   @relation(fields: [escolaId], references: [id])
  municipioId  String?
  municipio    Municipio? @relation(fields: [municipioId], references: [id])

  @@map("users")
}

model Municipio {
  id            String    @id @default(uuid())
  nome          String
  nomeNormalizado String?
  uf            String
  codigoIbge    String?   @unique
  ativo         Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  escolas       Escola[]
  produtores    Produtor[]
  editais       Edital[]
  users         User[]

  @@index([uf, nomeNormalizado])
  @@map("municipios")
}

model Escola {
  id            String    @id @default(uuid())
  nome          String
  codigo        String?   @unique
  municipioId   String
  municipio     Municipio @relation(fields: [municipioId], references: [id])
  endereco      String?
  telefone      String?
  responsavel   String?
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  restricaoAtendimento String?
  localizacao String?
  localidadeDiferenciada String?
  categoriaAdministrativa String?
  dependenciaAdministrativa String?
  categoriaEscolaPrivada String?
  conveniadaPoderPublico String?
  regulamentacaoConselho String?
  porteEscola String?
  etapasModalidades String? @db.Text
  outrasOfertasEducacionais String?
  latitude Decimal? @db.Decimal(12, 8)
  longitude Decimal? @db.Decimal(12, 8)
  editais       Edital[]
  editaisVinculados EditalEscola[]
  matches       Match[]
  users         User[]

  @@map("escolas")
}

model Edital {
  id            String          @id @default(uuid())
  numero        String
  ano           Int
  titulo        String
  descricao     String?         @db.Text
  objeto        String?         @db.Text
  status        StatusEdital    @default(RASCUNHO)
  municipioId   String?
  municipio     Municipio?      @relation(fields: [municipioId], references: [id])
  escolaId      String?
  escola        Escola?         @relation(fields: [escolaId], references: [id])
  arquivoFonte  String?
  observacoes   String?         @db.Text
  dataPublicacao DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  createdBy     String?
  updatedBy     String?
  itens         EditalItem[]
  propostas     Proposta[]
  importLogs    ImportLog[]
  matches       Match[]
  escolasVinculadas EditalEscola[]

  @@map("pnae_editais")
}

model EditalEscola {
  id        String   @id @default(uuid())
  editalId  String
  edital    Edital   @relation(fields: [editalId], references: [id])
  escolaId  String
  escola    Escola   @relation(fields: [escolaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([editalId, escolaId])
  @@map("pnae_edital_escolas")
}

model EditalItem {
  id                  String            @id @default(uuid())
  editalId            String
  edital              Edital            @relation(fields: [editalId], references: [id])
  numeroItem          Int?
  produtoOriginal     String
  especificacao      String?           @db.Text
  quantidade         Decimal?          @db.Decimal(10, 2)
  unidade            String?
  precoUnitario      Decimal?          @db.Decimal(10, 2)
  valorTotal         Decimal?          @db.Decimal(10, 2)
  observacoes        String?           @db.Text
  produtoReferenciaId String?
  produtoReferencia  ProdutoReferencia? @relation(fields: [produtoReferenciaId], references: [id])
  status             StatusItemEdital  @default(PENDENTE)
  pendenteEdicao     Boolean           @default(false)
  importadoAutomaticamente Boolean     @default(false)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  deletedAt          DateTime?
  createdBy          String?
  updatedBy          String?
  matches            Match[]

  @@map("pnae_edital_itens")
}

model ProdutoReferencia {
  id                    String         @id @default(uuid())
  nome                  String
  categoria             String?
  subcategoria          String?
  unidadePadrao         String?
  palavrasChave         String?
  sinonimos             String?
  agriculturaFamiliar   Boolean        @default(true)
  ativo                 Boolean        @default(true)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  editalItems           EditalItem[]
  matches               Match[]

  @@map("pnae_produtos_referencia")
}

model Produtor {
  id              String            @id @default(uuid())
  nome            String
  cpfCnpj         String?           @unique
  municipioId     String
  municipio       Municipio         @relation(fields: [municipioId], references: [id])
  endereco        String?
  telefone        String?
  active          Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?
  produtos        ProdutorProduto[]
  matches         Match[]
  propostas       Proposta[]

  @@map("produtores")
}

model ProdutorProduto {
  id               String    @id @default(uuid())
  produtorId       String
  produtor         Produtor  @relation(fields: [produtorId], references: [id])
  produto          String
  capacidade       String?
  periodoProducao  String?
  precoSugerido    Decimal?  @db.Decimal(10, 2)
  unidade          String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  matches          Match[]

  @@map("produtor_produtos")
}

model Match {
  id                   String               @id @default(uuid())
  editalId             String?
  edital               Edital?              @relation(fields: [editalId], references: [id])
  editalItemId         String
  editalItem           EditalItem           @relation(fields: [editalItemId], references: [id])
  produtoReferenciaId  String?
  produtoReferencia    ProdutoReferencia?   @relation(fields: [produtoReferenciaId], references: [id])
  produtorId           String?
  produtor             Produtor?            @relation(fields: [produtorId], references: [id])
  produtorProdutoId    String?
  produtorProduto      ProdutorProduto?     @relation(fields: [produtorProdutoId], references: [id])
  escolaId             String?
  escola               Escola?              @relation(fields: [escolaId], references: [id])
  scoreMatch           Int                  @default(0) @map("score")
  status               StatusMatch          @default(PENDENTE)
  origemMatch          OrigemMatch          @default(AUTOMATICO)
  motivoScore          String?              @db.Text
  observacoes          String?              @map("observacao") @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?
  propostaItems        PropostaItem[]

  @@map("pnae_matches")
}

model Proposta {
  id               String           @id @default(uuid())
  editalId         String
  edital           Edital           @relation(fields: [editalId], references: [id])
  produtorId       String?
  produtor         Produtor?        @relation(fields: [produtorId], references: [id])
  numero           String?
  tipoDocumento    TipoProposta     @default(ANEXO_III)
  status           StatusProposta   @default(RASCUNHO)
  validadeDias     Int              @default(30)
  prazoEntrega     Int              @default(15)
  valorTotal       Decimal?         @db.Decimal(12, 2)
  arquivoPdfPath   String?
  arquivoDocxPath  String?
  observacao       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?
  itens            PropostaItem[]

  @@map("pnae_propostas")
}

model PropostaItem {
  id               String    @id @default(uuid())
  propostaId       String
  proposta         Proposta  @relation(fields: [propostaId], references: [id])
  matchId          String?
  match            Match?    @relation(fields: [matchId], references: [id])
  produto          String
  especificacao    String?
  marca            String?
  quantidade       Decimal?  @db.Decimal(10, 2)
  unidade          String?
  precoUnitario    Decimal?  @db.Decimal(10, 2)
  valorTotal       Decimal?  @db.Decimal(10, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  createdBy        String?
  updatedBy        String?

  @@map("pnae_proposta_itens")
}

model ImportLog {
  id              String    @id @default(uuid())
  editalId        String?
  edital          Edital?   @relation(fields: [editalId], references: [id])
  arquivoNome     String
  arquivoCaminho  String
  origem          String
  status          StatusImportacao @default(AGUARDANDO_PROCESSAMENTO)
  tituloExtraido  String?
  numeroExtraido  String?
  anoExtraido     Int?
  municipioNome   String?
  escolaNome      String?
  objeto          String?   @db.Text
  resumo          String?   @db.Text
  quantidadeItens Int       @default(0)
  tempoProcessamentoMs Int?
  mensagemErro    String?   @db.Text
  processadoEm    DateTime?
  confirmadoEm    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  createdBy       String?
  updatedBy       String?

  @@map("pnae_import_logs")
}

model AuditLog {
  id            String    @id @default(uuid())
  userId        String?
  userName      String?
  userEmail     String?
  userRole      String?
  action        String
  entity        String
  entityId      String?
  entityLabel   String?
  oldValues     String?   @db.Text
  newValues     String?   @db.Text
  ipAddress     String?
  userAgent     String?
  endpoint      String?
  method        String?
  statusCode    Int?
  durationMs    Int?
  metadata      String?   @db.Text
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
  @@map("pnae_audit_logs")
}

model SystemConfig {
  id            String    @id @default(uuid())
  chave         String    @unique
  valor         String    @db.Text
  descricao     String?
  tipo          String    @default("texto")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("pnae_system_config")
}
