model NotaFiscal {
  id                    String                      @id @default(uuid())
  fornecedorId          String
  fornecedor            Produtor                    @relation(fields: [fornecedorId], references: [id])
  contratoId            String
  contrato              Contrato                    @relation(fields: [contratoId], references: [id])
  numero                String
  serie                 String?
  modelo                String?
  chaveAcesso           String?                     @unique
  dataEmissao           DateTime
  dataRecebimento       DateTime                    @default(now())
  cnpjEmitente          String?
  cpfEmitente           String?
  documentoDestinatario String?
  valorProdutos         Decimal                     @db.Decimal(14, 2)
  valorTotal            Decimal                     @db.Decimal(14, 2)
  valorDesconto         Decimal                     @default(0) @db.Decimal(14, 2)
  valorFrete            Decimal                     @default(0) @db.Decimal(14, 2)
  valorOutrasDespesas   Decimal                     @default(0) @db.Decimal(14, 2)
  status                StatusNotaFiscal            @default(PENDENTE_PROCESSAMENTO)
  resultadoConciliacao  ResultadoConciliacaoFiscal?
  xmlDocumentoId        String?                     @unique
  xmlDocumento          NotaFiscalDocumento?        @relation("NotaFiscalXml", fields: [xmlDocumentoId], references: [id])
  pdfDocumentoId        String?                     @unique
  pdfDocumento          NotaFiscalDocumento?        @relation("NotaFiscalPdf", fields: [pdfDocumentoId], references: [id])
  observacoes           String?                     @db.Text
  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  deletedAt             DateTime?
  createdBy             String?
  updatedBy             String?
  itens                 NotaFiscalItem[]
  documentos            NotaFiscalDocumento[]
  divergencias          DivergenciaFiscal[]
  conferencias          ConferenciaFiscal[]
  atestos               Atesto[]
  liquidacoes           Liquidacao[]
  vinculosRecebimento   VinculoRecebimentoFiscal[]
  pagamentos            Pagamento[]

  @@index([fornecedorId, contratoId])
  @@index([status])
  @@index([dataEmissao])
  @@index([resultadoConciliacao])
  @@map("pnae_notas_fiscais")
}

model NotaFiscalItem {
  id                  String                     @id @default(uuid())
  notaFiscalId        String
  notaFiscal          NotaFiscal                 @relation(fields: [notaFiscalId], references: [id])
  numeroItem          Int
  codigoProduto       String?
  descricao           String
  ncm                 String?
  cfop                String?
  unidadeComercial    String?
  quantidade          Decimal                    @db.Decimal(14, 4)
  valorUnitario       Decimal                    @db.Decimal(14, 4)
  valorTotal          Decimal                    @db.Decimal(14, 2)
  contratoItemId      String?
  contratoItem        ContratoItem?              @relation(fields: [contratoItemId], references: [id])
  observacoes         String?                    @db.Text
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  divergencias        DivergenciaFiscal[]
  vinculosRecebimento VinculoRecebimentoFiscal[]

  @@index([notaFiscalId])
  @@index([contratoItemId])
  @@map("pnae_nota_fiscal_itens")
}

model NotaFiscalDocumento {
  id            String      @id @default(uuid())
  notaFiscalId  String
  notaFiscal    NotaFiscal  @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)
  tipo          String
  versao        Int         @default(1)
  titulo        String
  arquivoPath   String
  arquivoNome   String
  mimeType      String?
  tamanhoBytes  Int
  hashSha256    String
  observacao    String?     @db.Text
  createdAt     DateTime    @default(now())
  createdBy     String?
  notaFiscalXml NotaFiscal? @relation("NotaFiscalXml")
  notaFiscalPdf NotaFiscal? @relation("NotaFiscalPdf")

  @@index([notaFiscalId])
  @@index([tipo])
  @@map("pnae_nota_fiscal_documentos")
}

model VinculoRecebimentoFiscal {
  id                  String         @id @default(uuid())
  notaFiscalId        String
  notaFiscal          NotaFiscal     @relation(fields: [notaFiscalId], references: [id])
  notaFiscalItemId    String
  notaFiscalItem      NotaFiscalItem @relation(fields: [notaFiscalItemId], references: [id])
  contratoId          String
  contrato            Contrato       @relation(fields: [contratoId], references: [id])
  contratoItemId      String
  contratoItem        ContratoItem   @relation(fields: [contratoItemId], references: [id])
  entregaId           String
  entrega             Entrega        @relation(fields: [entregaId], references: [id])
  entregaItemId       String
  entregaItem         EntregaItem    @relation(fields: [entregaItemId], references: [id])
  quantidadeVinculada Decimal        @db.Decimal(14, 4)
  valorUnitarioFiscal Decimal        @db.Decimal(14, 4)
  valorTotalVinculado Decimal        @db.Decimal(14, 2)
  observacoes         String?        @db.Text
  createdAt           DateTime       @default(now())
  createdBy           String?

  @@index([notaFiscalId])
  @@index([notaFiscalItemId])
  @@index([contratoId])
  @@index([entregaId])
  @@index([entregaItemId])
  @@map("pnae_vinculo_recebimento_fiscal")
}

model DivergenciaFiscal {
  id               String                  @id @default(uuid())
  notaFiscalId     String
  notaFiscal       NotaFiscal              @relation(fields: [notaFiscalId], references: [id])
  notaFiscalItemId String?
  notaFiscalItem   NotaFiscalItem?         @relation(fields: [notaFiscalItemId], references: [id])
  tipo             TipoDivergenciaFiscal
  severidade       SeveridadeDivergencia   @default(MEDIA)
  descricao        String                  @db.Text
  valorEsperado    String?                 @db.Text
  valorEncontrado  String?                 @db.Text
  status           StatusDivergenciaFiscal @default(ABERTA)
  responsavelId    String?
  justificativa    String?                 @db.Text
  evidenciaPath    String?
  dataResolucao    DateTime?
  resolvidoPor     String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([notaFiscalId])
  @@index([notaFiscalItemId])
  @@index([tipo])
  @@index([severidade])
  @@index([status])
  @@map("pnae_divergencias_fiscais")
}

model ConferenciaFiscal {
  id               String                  @id @default(uuid())
  notaFiscalId     String
  notaFiscal       NotaFiscal              @relation(fields: [notaFiscalId], references: [id])
  responsavelId    String
  responsavelNome  String?
  dataConferencia  DateTime                @default(now())
  status           StatusConferenciaFiscal
  observacoes      String?                 @db.Text
  divergenciasJson String?                 @db.Text
  createdAt        DateTime                @default(now())
  createdBy        String?

  @@index([notaFiscalId])
  @@index([responsavelId])
  @@index([status])
  @@index([dataConferencia])
  @@map("pnae_conferencias_fiscais")
}

model Atesto {
  id               String       @id @default(uuid())
  notaFiscalId     String
  notaFiscal       NotaFiscal   @relation(fields: [notaFiscalId], references: [id])
  contratoId       String
  contrato         Contrato     @relation(fields: [contratoId], references: [id])
  responsavelId    String
  dataAtesto       DateTime     @default(now())
  valorAtestado    Decimal      @db.Decimal(14, 2)
  status           StatusAtesto @default(RASCUNHO)
  justificativa    String?      @db.Text
  documentoId      String?
  documentoPath    String?
  hashSha256       String?
  versao           Int          @default(1)
  atestoAnteriorId String?      @unique
  atestoAnterior   Atesto?      @relation("AtestoRetificacao", fields: [atestoAnteriorId], references: [id])
  atestados        Atesto[]     @relation("AtestoRetificacao")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?

  @@index([notaFiscalId])
  @@index([contratoId])
  @@index([responsavelId])
  @@index([status])
  @@index([dataAtesto])
  @@index([atestoAnteriorId])
  @@map("pnae_atestos")
}

model Liquidacao {
