generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ESCOLA
  EXTENSIONISTA
  DRE
  PRODUTOR
  REPRESENTANTE
}

enum EscopoInstitucional {
  GLOBAL
  DRE
  ESCOLA
  MUNICIPIO
}

enum OrigemConfiguracao {
  ADMINISTRATIVA
  NORMATIVA
  SISTEMA
}

enum StatusParametroOperacional {
  ATIVO
  PENDENTE_VALIDACAO
  INATIVO
}

enum StatusNotificacaoInterna {
  NAO_LIDA
  LIDA
}

enum StatusChecklistImplantacao {
  NAO_INICIADO
  EM_CONFIGURACAO
  PENDENTE_VALIDACAO
  APTO_PARA_HOMOLOGACAO
  HOMOLOGADO_OPERACIONALMENTE
  BLOQUEADO
}

enum StatusItemChecklistImplantacao {
  PENDENTE
  EM_ANALISE
  CONCLUIDO
  BLOQUEADO
}

enum StatusUnidadeProdutiva {
  ATIVA
  INATIVA
}

enum StatusProdutoProdutor {
  ATIVO
  INATIVO
}

enum StatusSafraProducao {
  PLANEJADA
  EM_PRODUCAO
  EM_COLHEITA
  COLHIDA
  ENCERRADA
  CANCELADA
}

enum StatusDisponibilidadeProducao {
  PREVISTA
  CONFIRMADA
  COMPROMETIDA
  ENCERRADA
}

enum StatusNutricional {
  PENDENTE_VALIDACAO
  VALIDADA
  INATIVA
}

enum StatusAssistenciaTecnica {
  PENDENTE
  ATIVA
  SUSPENSA
  ENCERRADA
}

enum StatusEdital {
  RASCUNHO
  ATIVO
  FECHADO
  CANCELADO
}

enum StatusItemEdital {
  PENDENTE
  IMPORTADO
  CONFIRMADO
  PENDENTE_EDICAO
  PENDENTE_CONFERENCIA
}

enum StatusImportacao {
  AGUARDANDO_PROCESSAMENTO
  PROCESSANDO
  PROCESSADO
  PENDENTE_CONFERENCIA
  CONFIRMADO
  ERRO
}

enum StatusMatch {
  MATCH_AUTOMATICO
  SUGESTAO
  PENDENTE
  SEM_MATCH
  APROVADO
  REJEITADO
}

enum OrigemMatch {
  AUTOMATICO
  MANUAL
}

enum StatusProposta {
  RASCUNHO
  GERADA
  FINALIZADA
  CANCELADA
}

enum TipoProposta {
  ANEXO_III
  PROJETO_VENDA
}

enum StatusChamadaPublica {
  RASCUNHO
  PUBLICADA
  INSCRICOES_ABERTAS
  INSCRICOES_ENCERRADAS
  EM_HABILITACAO
  EM_SELECAO
  RESULTADO_PRELIMINAR
  EM_RECURSO
  HOMOLOGADA
  CANCELADA
}

enum CategoriaParticipante {
  INDIVIDUAL
  GRUPO_INFORMAL
  GRUPO_FORMAL
  OUTRA
}

enum StatusInscricaoChamada {
  ATIVA
  CANCELADA
}

enum StatusHabilitacaoChamada {
  PENDENTE
  EM_ANALISE
  HABILITADO
  INABILITADO
  PENDENTE_CORRECAO
}

enum StatusSelecaoChamada {
  PENDENTE
  CLASSIFICADO
  SELECIONADO
  NAO_SELECIONADO
}

enum StatusRecursoChamada {
  PENDENTE
  DEFERIDO
  INDEFERIDO
  PARCIALMENTE_DEFERIDO
}

model User {
  id                           String                               @id @default(uuid())
  name                         String
  email                        String                               @unique
  passwordHash                 String
  role                         Role                                 @default(ADMIN)
  active                       Boolean                              @default(true)
  createdAt                    DateTime                             @default(now())
  updatedAt                    DateTime                             @updatedAt
  deletedAt                    DateTime?
  createdBy                    String?
  updatedBy                    String?
  escolaId                     String?
  escola                       Escola?                              @relation(fields: [escolaId], references: [id])
  municipioId                  String?
  municipio                    Municipio?                           @relation(fields: [municipioId], references: [id])
  vinculos                     VinculoUsuario[]
  representacoes               RepresentacaoFornecedor[]
  configuracoesInstitucionais  ConfiguracaoInstitucional[]          @relation("ConfigResponsavel")
  configuracoesHistorico       ConfiguracaoInstitucionalHistorico[] @relation("ConfigHistoryResponsavel")
  parametrosResponsavel        ParametroOperacional[]               @relation("ParametroResponsavel")
  parametrosVersoesResponsavel ParametroOperacionalVersao[]         @relation("ParametroVersaoResponsavel")
  notificacoesInternas         NotificacaoInterna[]                 @relation("NotificationUser")
  checklistsResponsavel        ChecklistImplantacao[]               @relation("ChecklistResponsavel")
  itensChecklistResponsavel    ItemChecklistImplantacao[]           @relation("ChecklistItemResponsavel")
  assistenciasTecnicas         VinculoAssistenciaTecnica[]          @relation("AssistenciaExtensionista")
  catalogoSolicitacoes         SolicitacaoCatalogoProduto[]         @relation("CatalogoSolicitacaoUser")

  @@map("users")
}

model Municipio {
  id                          String                      @id @default(uuid())
  nome                        String
  nomeNormalizado             String?
  uf                          String
  codigoIbge                  String?                     @unique
  ativo                       Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  deletedAt                   DateTime?
  createdBy                   String?
  updatedBy                   String?
  escolas                     Escola[]
  produtores                  Produtor[]
  editais                     Edital[]
  users                       User[]
  entidadesExecutoras         EntidadeExecutora[]
  vinculosUsuario             VinculoUsuario[]
  contratos                   Contrato[]
  programacoesEntrega         ProgramacaoEntrega[]
  entregas                    Entrega[]
  chamadasPublicas            ChamadaPublica[]
  unidadesProdutivas          UnidadeProdutiva[]
  configuracoesInstitucionais ConfiguracaoInstitucional[] @relation("ConfigMunicipio")
  checklistsImplantacao       ChecklistImplantacao[]      @relation("ChecklistMunicipio")

  @@index([uf, nomeNormalizado])
  @@map("municipios")
}

model Escola {
  id                          String                      @id @default(uuid())
  nome                        String
  codigo                      String?                     @unique
  municipioId                 String
  municipio                   Municipio                   @relation(fields: [municipioId], references: [id])
  endereco                    String?
  telefone                    String?
  responsavel                 String?
  active                      Boolean                     @default(true)
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt
  deletedAt                   DateTime?
  createdBy                   String?
  updatedBy                   String?
  restricaoAtendimento        String?
  localizacao                 String?
  localidadeDiferenciada      String?
  categoriaAdministrativa     String?
  dependenciaAdministrativa   String?
  categoriaEscolaPrivada      String?
  conveniadaPoderPublico      String?
  regulamentacaoConselho      String?
  porteEscola                 String?
  etapasModalidades           String?                     @db.Text
  outrasOfertasEducacionais   String?
  latitude                    Decimal?                    @db.Decimal(12, 8)
  longitude                   Decimal?                    @db.Decimal(12, 8)
  editais                     Edital[]
  editaisVinculados           EditalEscola[]
  matches                     Match[]
  users                       User[]
  vinculosDRE                 VinculoEscolaDRE[]
  vinculosUsuario             VinculoUsuario[]
  prestacoesContas            PrestacaoContas[]
  chamadasPublicas            ChamadaPublicaEscola[]
  configuracoesInstitucionais ConfiguracaoInstitucional[] @relation("ConfigEscola")
  checklistsImplantacao       ChecklistImplantacao[]      @relation("ChecklistEscola")
  contratos                   Contrato[]
  programacoesEntrega         ProgramacaoEntrega[]
  entregas                    Entrega[]

  @@map("escolas")
}

model Edital {
  id                String           @id @default(uuid())
  numero            String
  ano               Int
  titulo            String
  descricao         String?          @db.Text
  objeto            String?          @db.Text
  status            StatusEdital     @default(RASCUNHO)
  municipioId       String?
  municipio         Municipio?       @relation(fields: [municipioId], references: [id])
  escolaId          String?
  escola            Escola?          @relation(fields: [escolaId], references: [id])
  arquivoFonte      String?
  observacoes       String?          @db.Text
  dataPublicacao    DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  deletedAt         DateTime?
  createdBy         String?
  updatedBy         String?
  itens             EditalItem[]
  propostas         Proposta[]
  importLogs        ImportLog[]
  matches           Match[]
  escolasVinculadas EditalEscola[]
  documento         EditalDocumento?
  chamadasPublicas  ChamadaPublica[]
  contratos         Contrato[]

  @@map("pnae_editais")
}

model EditalEscola {
  id        String   @id @default(uuid())
  editalId  String
  edital    Edital   @relation(fields: [editalId], references: [id])
  escolaId  String
  escola    Escola   @relation(fields: [escolaId], references: [id])
  createdAt DateTime @default(now())

  @@unique([editalId, escolaId])
  @@map("pnae_edital_escolas")
}

model EditalItem {
  id                       String                    @id @default(uuid())
  editalId                 String
  edital                   Edital                    @relation(fields: [editalId], references: [id])
  numeroItem               Int?
  produtoOriginal          String
  especificacao            String?                   @db.Text
  quantidade               Decimal?                  @db.Decimal(10, 2)
  unidade                  String?
  precoUnitario            Decimal?                  @db.Decimal(10, 2)
  valorTotal               Decimal?                  @db.Decimal(10, 2)
  observacoes              String?                   @db.Text
  produtoReferenciaId      String?
  produtoReferencia        ProdutoReferencia?        @relation(fields: [produtoReferenciaId], references: [id])
  status                   StatusItemEdital          @default(PENDENTE)
  pendenteEdicao           Boolean                   @default(false)
  importadoAutomaticamente Boolean                   @default(false)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  deletedAt                DateTime?
  createdBy                String?
  updatedBy                String?
  matches                  Match[]
  contratoItens            ContratoItem[]
  classificacoes           ClassificacaoProjeto[]
  mapeamentosProduto       MapeamentoProdutoEdital[]

  @@map("pnae_edital_itens")
}

model ProdutoReferencia {
  id                      String                    @id @default(uuid())
  nome                    String
  categoria               String?
  subcategoria            String?
  unidadePadrao           String?
  palavrasChave           String?
  sinonimos               String?
  agriculturaFamiliar     Boolean                   @default(true)
  ativo                   Boolean                   @default(true)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  deletedAt               DateTime?
  createdBy               String?
  updatedBy               String?
  editalItems             EditalItem[]
  matches                 Match[]
  produtosProdutor        ProdutorProduto[]
  informacoesNutricionais InformacaoNutricional[]
  mapeamentosProduto      MapeamentoProdutoEdital[]

  @@map("pnae_produtos_referencia")
}

model Produtor {
  id                   String                      @id @default(uuid())
  nome                 String
  cpfCnpj              String?                     @unique
  municipioId          String
  municipio            Municipio                   @relation(fields: [municipioId], references: [id])
  endereco             String?
  telefone             String?
  dadosDocumentais     Json?
  active               Boolean                     @default(true)
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  deletedAt            DateTime?
  createdBy            String?
  updatedBy            String?
  produtos             ProdutorProduto[]
  matches              Match[]
  propostas            Proposta[]
  representacoes       RepresentacaoFornecedor[]
  vinculosUsuario      VinculoUsuario[]
  contratos            Contrato[]
  programacoesEntrega  ProgramacaoEntrega[]
  entregas             Entrega[]
  notasFiscais         NotaFiscal[]
  inscricoesChamada    InscricaoChamada[]
  recursosChamada      RecursoChamada[]
  unidadesProdutivas   UnidadeProdutiva[]
  safrasProducao       SafraProducao[]
  sazonalidades        SazonalidadeProducao[]
  disponibilidades     DisponibilidadeProducao[]
  logistica            LogisticaProdutor[]
  assistenciasTecnicas VinculoAssistenciaTecnica[] @relation("AssistenciaProdutor")
  mapeamentosProduto   MapeamentoProdutoEdital[]

  @@map("produtores")
}

model ProdutorProduto {
  id                  String                    @id @default(uuid())
  produtorId          String
  produtor            Produtor                  @relation(fields: [produtorId], references: [id])
  produto             String
  capacidade          String?
  periodoProducao     String?
  precoSugerido       Decimal?                  @db.Decimal(10, 2)
  unidade             String?
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  matches             Match[]
  produtoReferenciaId String?
  produtoReferencia   ProdutoReferencia?        @relation(fields: [produtoReferenciaId], references: [id])
  unidadeProdutivaId  String?
  unidadeProdutiva    UnidadeProdutiva?         @relation(fields: [unidadeProdutivaId], references: [id])
  status              StatusProdutoProdutor     @default(ATIVO)
  safras              SafraProducao[]
  sazonalidades       SazonalidadeProducao[]
  disponibilidades    DisponibilidadeProducao[]
  mapeamentosEdital   MapeamentoProdutoEdital[]

  @@map("produtor_produtos")
}

model UnidadeProdutiva {
  id           String                 @id @default(uuid())
  produtorId   String
  produtor     Produtor               @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  municipioId  String
  municipio    Municipio              @relation(fields: [municipioId], references: [id], onDelete: Restrict)
  nome         String
  comunidade   String?
  descricao    String?                @db.Text
  areaHectares Decimal?               @db.Decimal(12, 4)
  latitude     Decimal?               @db.Decimal(12, 8)
  longitude    Decimal?               @db.Decimal(12, 8)
  status       StatusUnidadeProdutiva @default(ATIVA)
  versao       Int                    @default(1)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  deletedAt    DateTime?
  createdBy    String?
  updatedBy    String?
  produtos     ProdutorProduto[]
  safras       SafraProducao[]

  @@index([produtorId, status])
  @@index([municipioId])
  @@map("sdd010_unidades_produtivas")
}

model SafraProducao {
  id                     String                    @id @default(uuid())
  produtorId             String
  produtor               Produtor                  @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  unidadeProdutivaId     String?
  unidadeProdutiva       UnidadeProdutiva?         @relation(fields: [unidadeProdutivaId], references: [id], onDelete: SetNull)
  produtoProdutorId      String
  produtoProdutor        ProdutorProduto           @relation(fields: [produtoProdutorId], references: [id], onDelete: Restrict)
  nome                   String
  inicio                 DateTime
  fim                    DateTime
  quantidadePrevista     Decimal                   @db.Decimal(14, 4)
  quantidadeColhida      Decimal                   @default(0) @db.Decimal(14, 4)
  perdas                 Decimal                   @default(0) @db.Decimal(14, 4)
  quantidadeReservada    Decimal                   @default(0) @db.Decimal(14, 4)
  quantidadeComprometida Decimal                   @default(0) @db.Decimal(14, 4)
  unidade                String
  status                 StatusSafraProducao       @default(PLANEJADA)
  versao                 Int                       @default(1)
  observacoes            String?                   @db.Text
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  deletedAt              DateTime?
  createdBy              String?
  updatedBy              String?
  sazonalidades          SazonalidadeProducao[]
  disponibilidades       DisponibilidadeProducao[]

  @@index([produtorId, status])
  @@index([produtoProdutorId, inicio, fim])
  @@map("sdd010_safras_producao")
}

model SazonalidadeProducao {
  id                 String          @id @default(uuid())
  produtorId         String
  produtor           Produtor        @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  safraProducaoId    String?
  safraProducao      SafraProducao?  @relation(fields: [safraProducaoId], references: [id], onDelete: Cascade)
  produtoProdutorId  String
  produtoProdutor    ProdutorProduto @relation(fields: [produtoProdutorId], references: [id], onDelete: Restrict)
  mes                Int
  quantidadePrevista Decimal         @db.Decimal(14, 4)
  unidade            String
  observacoes        String?         @db.Text
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  createdBy          String?
  updatedBy          String?

  @@unique([produtorId, produtoProdutorId, mes, safraProducaoId])
  @@index([produtorId, mes])
  @@map("sdd010_sazonalidade_producao")
}

model DisponibilidadeProducao {
  id                String                        @id @default(uuid())
  produtorId        String
  produtor          Produtor                      @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  safraProducaoId   String
  safraProducao     SafraProducao                 @relation(fields: [safraProducaoId], references: [id], onDelete: Cascade)
  produtoProdutorId String
  produtoProdutor   ProdutorProduto               @relation(fields: [produtoProdutorId], references: [id], onDelete: Restrict)
  quantidade        Decimal                       @db.Decimal(14, 4)
  unidade           String
  status            StatusDisponibilidadeProducao @default(PREVISTA)
  origem            String
  origemId          String?
  periodoInicio     DateTime?
  periodoFim        DateTime?
  observacoes       String?                       @db.Text
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  createdBy         String?
  updatedBy         String?

  @@index([produtorId, status])
  @@index([safraProducaoId])
  @@map("sdd010_disponibilidades_producao")
}

model LogisticaProdutor {
  id                  String   @id @default(uuid())
  produtorId          String
  produtor            Produtor @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  modalidade          String
  municipiosAtendidos String?  @db.Text
  capacidadeDiaria    Decimal? @db.Decimal(14, 4)
  unidadeCapacidade   String?
  raioKm              Decimal? @db.Decimal(10, 2)
  ativo               Boolean  @default(true)
  observacoes         String?  @db.Text
  versao              Int      @default(1)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  createdBy           String?
  updatedBy           String?

  @@index([produtorId, ativo])
  @@map("sdd010_logistica_produtor")
}

model InformacaoNutricional {
  id                  String            @id @default(uuid())
  produtoReferenciaId String
  produtoReferencia   ProdutoReferencia @relation(fields: [produtoReferenciaId], references: [id], onDelete: Cascade)
  fonte               String
  versaoFonte         String?
  estadoAlimento      String?
  porcao              String?
  energiaKcal         Decimal?          @db.Decimal(12, 4)
  proteinaG           Decimal?          @db.Decimal(12, 4)
  carboidratoG        Decimal?          @db.Decimal(12, 4)
  lipidiosG           Decimal?          @db.Decimal(12, 4)
  fibraG              Decimal?          @db.Decimal(12, 4)
  sodioMg             Decimal?          @db.Decimal(12, 4)
  status              StatusNutricional @default(PENDENTE_VALIDACAO)
  validadoPor         String?
  validadoEm          DateTime?
  observacoes         String?           @db.Text
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  createdBy           String?
  updatedBy           String?

  @@index([produtoReferenciaId, status])
  @@map("sdd010_informacoes_nutricionais")
}

model VinculoAssistenciaTecnica {
  id              String                   @id @default(uuid())
  produtorId      String
  produtor        Produtor                 @relation("AssistenciaProdutor", fields: [produtorId], references: [id], onDelete: Cascade)
  extensionistaId String
  extensionista   User                     @relation("AssistenciaExtensionista", fields: [extensionistaId], references: [id], onDelete: Restrict)
  escopo          String?
  vigenciaInicio  DateTime
  vigenciaFim     DateTime?
  status          StatusAssistenciaTecnica @default(PENDENTE)
  observacoes     String?                  @db.Text
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdBy       String?
  updatedBy       String?

  @@index([produtorId, status])
  @@index([extensionistaId, status])
  @@map("sdd010_assistencia_tecnica")
}

model MapeamentoProdutoEdital {
  id                  String             @id @default(uuid())
  produtorId          String
  produtor            Produtor           @relation(fields: [produtorId], references: [id], onDelete: Cascade)
  produtoProdutorId   String
  produtoProdutor     ProdutorProduto    @relation(fields: [produtoProdutorId], references: [id], onDelete: Restrict)
  produtoReferenciaId String?
  produtoReferencia   ProdutoReferencia? @relation(fields: [produtoReferenciaId], references: [id], onDelete: SetNull)
  editalItemId        String
  editalItem          EditalItem         @relation(fields: [editalItemId], references: [id], onDelete: Cascade)
  compatibilidade     Decimal?           @db.Decimal(5, 2)
  justificativa       String?            @db.Text
  revisaoStatus       String             @default("PENDENTE_REVISAO")
  revisadoPor         String?
  revisadoEm          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  createdBy           String?
  updatedBy           String?

  @@unique([produtoProdutorId, editalItemId])
  @@index([produtorId, revisaoStatus])
  @@map("sdd010_mapeamentos_produto_edital")
}

model SolicitacaoCatalogoProduto {
  id            String    @id @default(uuid())
  nome          String
  categoria     String?
  unidadePadrao String?
  justificativa String?   @db.Text
  status        String    @default("PENDENTE")
  solicitanteId String
  solicitante   User      @relation("CatalogoSolicitacaoUser", fields: [solicitanteId], references: [id], onDelete: Restrict)
  analisadoPor  String?
  analisadoEm   DateTime?
  observacoes   String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, createdAt])
  @@map("sdd010_solicitacoes_catalogo")
}

model Match {
  id                  String             @id @default(uuid())
  editalId            String?
  edital              Edital?            @relation(fields: [editalId], references: [id])
  editalItemId        String
  editalItem          EditalItem         @relation(fields: [editalItemId], references: [id])
  produtoReferenciaId String?
  produtoReferencia   ProdutoReferencia? @relation(fields: [produtoReferenciaId], references: [id])
  produtorId          String?
  produtor            Produtor?          @relation(fields: [produtorId], references: [id])
  produtorProdutoId   String?
  produtorProduto     ProdutorProduto?   @relation(fields: [produtorProdutoId], references: [id])
  escolaId            String?
  escola              Escola?            @relation(fields: [escolaId], references: [id])
  scoreMatch          Int                @default(0) @map("score")
  status              StatusMatch        @default(PENDENTE)
  origemMatch         OrigemMatch        @default(AUTOMATICO)
  motivoScore         String?            @db.Text
  observacoes         String?            @map("observacao") @db.Text
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  deletedAt           DateTime?
  createdBy           String?
  updatedBy           String?
  propostaItems       PropostaItem[]

  @@map("pnae_matches")
}

model Proposta {
  id                    String                   @id @default(uuid())
  editalId              String
  edital                Edital                   @relation(fields: [editalId], references: [id])
  produtorId            String?
  produtor              Produtor?                @relation(fields: [produtorId], references: [id])
  numero                String?
  tipoDocumento         TipoProposta             @default(ANEXO_III)
  status                StatusProposta           @default(RASCUNHO)
  validadeDias          Int                      @default(30)
  prazoEntrega          Int                      @default(15)
  valorTotal            Decimal?                 @db.Decimal(12, 2)
